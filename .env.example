# Скопируйте в .env и поменяйте значения.
POSTGRES_PASSWORD=trainer
# Токен суперадмина (вход на главной → «Администрирование»). Обязателен, не короче 12 знаков:
#   openssl rand -hex 24
ADMIN_TOKEN=change-me-please
WEB_PORT=8080
# Сервер (compose.prod.yml): адрес сайта для Caddy, домен или <ip-с-дефисами>.sslip.io
SITE_ADDRESS=
# Логи API: debug | info | warn
LOG_LEVEL=info
# Метка сборки (попадает в логи и отчёты), например дата или хеш коммита
APP_BUILD=

# --- compose.logs.yml (необязательно)
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001
GLITCHTIP_PORT=8001
# openssl rand -hex 32
GLITCHTIP_SECRET=
# DSN из GlitchTip после создания проекта
SENTRY_DSN=
VITE_SENTRY_DSN=
